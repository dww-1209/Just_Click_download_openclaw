# Python-generated files
__pycache__/
*.py[oc]
*.egg-info

# Build outputs
build/
dist/
wheels/

# Virtual environments
.venv

# Lint / Format caches
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / local config
.python-version
.env
.env.local

# Logs and temp files
*.log
logs.txt
openclaw.json
temp_*

# Media / docs that shouldn't be versioned
image.png
*.docx
*.doc

# PyInstaller auto-generated spec (we use build.py as source of truth)
*.spec

# macOS
.DS_Store

# Project-specific excluded files
AGENTS.md
install.ps1
install.sh
provider.txt
promote.txt
agentclaw/

# Claude Code local state
.claude/

# Bundled platform binaries (downloaded via prepare_offline_resources.py)
resources/*/node-*.tar.gz
resources/*/node-*.tar.xz
resources/*/node-*.zip
resources/*/openclaw-prebuilt-*.tar.gz
resources/pnpm-*.tgz
