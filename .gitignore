# Python-generated files
__pycache__/
*.py[oc]
*.egg-info

# Build outputs
build/
dist/
wheels/

# Virtual environments
.venv

# Lint / Format caches
.ruff_cache/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment / local config
.python-version
.env
.env.local

# Logs and temp files
*.log
logs.txt
openclaw.json
temp_*

# Media / docs that shouldn't be versioned
image.png
*.docx
*.doc

# PyInstaller auto-generated spec (we use build.py as source of truth)
*.spec

# macOS
.DS_Store

# Project-specific excluded files
AGENTS.md
install.ps1
install.sh
provider.txt
promote.txt
agentclaw/

# Offline resources (large binaries > 100MB, user-provided)
# Directory structure is preserved via .gitkeep
resources/**/*.tar.gz
resources/**/*.tar.xz
resources/**/*.zip
resources/**/*.tgz
!resources/**/.gitkeep

# Source logo (设计稿,不入仓库,跨机器各自准备 resources/logo.png 后跑 generate_icons.py)
resources/logo.png

# Claude Code local state
.claude/
