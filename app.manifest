<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <!--
          等级说明：
          - asInvoker: 以当前用户权限运行（默认）
          - highestAvailable: 请求当前用户可用的最高权限
          - requireAdministrator: 总是要求管理员权限

          我们使用：asInvoker
          原因：
          1. Node.js/Git/OpenClaw 全部安装在用户目录（~/.openclaw-node、~/openclaw-cn、~/.openclaw），无需管理员权限。
          2. 极少数需要管理员的步骤（如某些 MSI 安装器）由 Windows 自身在调用时弹出 UAC，单独获取权限即可。
          3. 全程使用管理员权限会导致：
             - 用户级代理/网络配置在管理员上下文中失效，造成下载失败；
             - 安装产物归属 Administrators 组，普通用户读写时遇权限错误；
             - 每次启动都弹 UAC，影响体验。
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  
  <!-- 兼容性设置 -->
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- 支持 Windows 10/11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/> <!-- Windows 10 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/> <!-- Windows 11 -->
    </application>
  </compatibility>
  
  <!-- 应用程序信息 -->
  <assemblyIdentity
    version="1.0.0.0"
    processorArchitecture="*"
    name="OpenClaw.Installer"
    type="win32"/>
    
  <!-- 程序显示名称 -->
  <description>OpenClaw 一键安装程序</description>
</assembly>